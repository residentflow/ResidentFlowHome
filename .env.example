# ============================================================
# ResidentFlow — Umgebungsvariablen (Beispieldatei)
# ============================================================
# Diese Datei ist ein Template. Kopieren Sie sie als .env und
# tragen Sie Ihre echten Werte ein. Commit NIEMALS die .env!
# ============================================================

# ----------------------------------------------------------
# Brevo (ehemals Sendinblue) — Transaktions-E-Mail & Opt-in
# Auftragsverarbeiter nach DSGVO (AVV liegt vor).
# §11, §15.3: POST /api/optin sendet PDF + Kontaktattribute.
# ----------------------------------------------------------

# API-Schlüssel aus Ihrem Brevo-Konto (Einstellungen → API)
BREVO_API_KEY=

# ID der Brevo-Liste für den Double-Opt-in-Abo-Kanal
BREVO_LIST_ID=

# ----------------------------------------------------------
# Plausible Analytics — cookieless self-hosted
# §16: kein personenbezogenes Tracking, kein Cookie-Banner.
# ----------------------------------------------------------

# Die Domain, für die Plausible messen soll (z.B. residentflow.de)
PLAUSIBLE_DOMAIN=

# ----------------------------------------------------------
# Plausible selbst-gehostete Instanz (optional, falls eigene)
# Leer lassen für cloud.plausible.io
# ----------------------------------------------------------
PLAUSIBLE_BASE_URL=

# ----------------------------------------------------------
# API-Server
# ----------------------------------------------------------

# Port, auf dem der Fastify-API-Server lauscht
PORT=3001

# Erlaubte Origins für CORS (Komma-getrennt)
CORS_ORIGIN=http://localhost:5173
