# ============================================================
# Dockerfile.web — Multi-Stage Build: Node → nginx
# Stage 1: Vite-Build des React-Frontend (ohne CMS/Admin)
# Stage 2: nginx serviert das statische dist/
# §15.3: CMS ist NICHT im Prod-Build enthalten
# ============================================================

# ---- Stage 1: Build ----------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# Abhängigkeiten zuerst (Layer-Cache)
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# Quellcode kopieren (ohne api/, nginx/, docker*)
COPY tsconfig.json vite.config.ts ./
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./

# Produktions-Build
RUN npm run build

# ---- Stage 2: nginx ----------------------------------------
FROM nginx:1.27-alpine AS web

# Konfiguration einbinden (wird auch per Volume im Compose überschrieben)
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Statisches Build hineinkopieren
COPY --from=build /app/dist /usr/share/nginx/html

# nginx lauscht auf 80 (TLS wird im Compose-nginx-Proxy beendet)
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
