{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./payload.config.ts"]
    },
    "isolatedModules": true
  },
  "include": ["src", "*.ts", "*.mjs", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/seed.ts",
    "src/export-config.ts",
    "src/verify.ts",
    "src/verify-lead.ts"
  ]
}
